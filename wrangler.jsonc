{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yifunlife-erp",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "send_email": [
    {
      "name": "AUTH_EMAIL",
      "remote": true
    }
  ]
}
